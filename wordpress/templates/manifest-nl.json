      },
      {
       "id": "5b1a623",
       "elType": "widget",
       "settings": {
        "title": "III. Echte impact",
        "header_size": "h2",
        "_css_classes": "ub-step-title"
       },
       "elements": [],
       "widgetType": "heading"
      },
      {
       "id": "bf2b5df",
       "elType": "widget",
       "settings": {
        "editor": "<p>Talent binnen de ummah is groot maar verspreid. Via projectgroepen, hackathons en sharktank-sessies zetten we ideeën om in werkende projecten.</p>"
       },
       "elements": [],
       "widgetType": "text-editor"
      },
      {
       "id": "7affcd1",
       "elType": "widget",
       "settings": {
        "space": {
