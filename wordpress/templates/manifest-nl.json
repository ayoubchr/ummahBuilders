      },
      {
       "id": "712a8cc",
       "elType": "widget",
       "settings": {
        "title": "I. Binnen islamitische grenzen",
        "header_size": "h2",
        "_css_classes": "ub-step-title"
       },
       "elements": [],
       "widgetType": "heading"
      },
      {
       "id": "74ddaf7",
       "elType": "widget",
       "settings": {
        "editor": "<p>Alles wat we doen gebeurt binnen duidelijke islamitische grenzen: in hoe we omgaan met elkaar, met geld en met data.</p>"
       },
       "elements": [],
       "widgetType": "text-editor"
      },
      {
       "id": "c6d1720",
       "elType": "widget",
       "settings": {
        "space": {
