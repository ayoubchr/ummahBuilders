      {
       "id": "6f8619c",
       "elType": "widget",
       "settings": {
        "title": "V. Wat we niet doen",
        "header_size": "h2",
        "_css_classes": "ub-step-title"
       },
       "elements": [],
       "widgetType": "heading"
      },
      {
       "id": "7de5dd9",
       "elType": "widget",
       "settings": {
        "editor": "<p>Geen verslavend algoritme, geen DM-cultuur en geen misbruik van data. Geld dat door de community gaat, wordt transparant gerapporteerd.</p>"
