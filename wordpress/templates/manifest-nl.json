      },
      {
       "id": "637ebcb",
       "elType": "widget",
       "settings": {
        "title": "II. Kwaliteit en kennis",
        "header_size": "h2",
        "_css_classes": "ub-step-title"
       },
       "elements": [],
       "widgetType": "heading"
      },
      {
       "id": "9f07b63",
       "elType": "widget",
       "settings": {
        "editor": "<p>We kiezen voor inhoud boven lawaai. Gestructureerde gesprekken, een gedeelde kennisbank en mentoring door ervaren professionals.</p>"
       },
       "elements": [],
       "widgetType": "text-editor"
      },
      {
       "id": "641d498",
       "elType": "widget",
       "settings": {
        "space": {
         "unit": "px",
         "size": 20,
         "sizes": []
        }
       },
       "elements": [],
